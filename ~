@font-face {
  font-family: "PSO";
  src: url("../../src/fonts/pso_font.ttf") format("truetype");
}

.star-stream {
  position: absolute;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100vw;
  margin-top: -4.5vw;
  z-index: 3;
  filter: blur(0.3vw);
  overflow: hidden;
  mix-blend-mode: screen;
}

.stream-particle {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  width: var(--r);
  height: var(--r);
  background-color: hsl(206, 100%, var(--lightness));
  transform: translateY(var(--start-y)) translateX(var(--start-x));
  animation-iteration-count: infinite;
  animation-duration: var(--duration);
  animation-delay: var(--delay);
}

.stream-right { animation-name: stream-right; }
.stream-left  { animation-name: stream-left; }

@keyframes stream-right {
  0%   { background-color: hsl(206, 100%, 100%); }
  17%  { background-color: hsl(206, 100%, 80%); }
  100% {
    transform: translateY(var(--start-y)) translateX(calc(var(--start-x) + 55vw)) scale(0.1);
    background-color: hsl(206, 100%, 40%);
  }
}

@keyframes stream-left {
  0%   { background-color: hsl(206, 100%, 100%); }
  10%  { background-color: hsl(206, 100%, 80%); }
  100% {
    transform: translateY(var(--start-y)) translateX(calc(var(--start-x) - 55vw)) scale(0.1);
    background-color: hsl(206, 100%, 40%);
  }
}

.starburst {
  position: absolute;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100vw;
  margin-top: -3vw;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: blur(0.12vw);
}

.ray {
  position: absolute;
  transform: rotate(calc(360deg * var(--rot))) translateY(calc(var(--length) / -2 - 1.5vw));
  height: var(--length);
  width: 1.4vw;
  background-color: hsl(var(--hue), 100%, 87%);
  clip-path: polygon(41% 68%, 45% 90%, 51% 100%, 57% 90%, 61% 68%, 62% 55%, 51% 0, 40% 56%);
  opacity: 0;
  animation-name: ray-move, ray-sparkle, ray-hide;
  animation-iteration-count: infinite;
  animation-duration: 3s, 3s, var(--duration2);
  animation-delay: var(--delay1), var(--delay1), var(--delay2);
}

@keyframes ray-sparkle {
  0%  { opacity: 0; }
  20% { opacity: 1; }
  60% { opacity: 0; }
}

@keyframes ray-move {
  from { transform: rotate(calc(360deg * var(--rot))) translateY(calc(var(--length) / -3)); }
}

@keyframes ray-hide {
  0%   { visibility: hidden; }
  50%  { visibility: hidden; }
  100% { visibility: visible; }
}

.bg-text {
  position: absolute;
  top: 0;
  left: 0;
  height: 100vh;
  width: 100vw;
  z-index: 1;
  opacity: 0.45;
  display: grid;
  grid-template-columns: 50vw 50vw;
  grid-template-rows: 100vh;
  font-family: monospace;
  pointer-events: none;
}

.text-box {
  padding: 0 1vw;
  font-size: 1.3vw;
  color: white;
  font-family: "PSO", monospace;
}

.align-left { text-align: left; }
.align-right { text-align: right; }
